# Copy to .env and fill in. Only one LLM is needed; without any, a built-in heuristic picks clips.

# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Any OpenAI-compatible API (DeepSeek, OpenRouter, Groq...). Used if GEMINI_API_KEY is empty.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
OPENAI_COMPAT_MODEL=deepseek-chat

# Optional, for YouTube downloads from a VPS (see README "YouTube blocks").
YTDLP_COOKIES=
YTDLP_PROXY=
